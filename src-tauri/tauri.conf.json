{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worklog Hub",
  "version": "1.0.0",
  "identifier": "com.workloghub.dev",
  "build": {
    "beforeDevCommand": "bunx vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:server:win",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worklog Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/worklog-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
