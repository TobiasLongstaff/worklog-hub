{
  "language": "es",
  "memoryPath": "./memory",
  "daysToScan": 3,
  "maxAgentSessions": 5,
  "maxAgentMessagesPerSession": 20,

  "projects": [
    {
      "name": "mi-frontend",
      "path": "../mi-frontend",
      "type": "frontend"
    },
    {
      "name": "mi-backend",
      "path": "../mi-backend",
      "type": "backend"
    }
  ],

  "stack": {
    "frontend": "React 18, TypeScript, Vite, TailwindCSS, React Hook Form, Zod",
    "backend": "Node.js, Express, PostgreSQL, Drizzle ORM",
    "testing": "Vitest, Playwright"
  },

  "agentLogs": {
    "claudeCode": {
      "enabled": true,
      "basePath": "~/.claude/projects"
    },
    "openCode": {
      "enabled": true,
      "basePath": "~/.local/share/opencode"
    }
  }
}
