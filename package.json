{
  "name": "worklog-hub",
  "version": "1.0.0",
  "description": "Memoria de trabajo local-first para desarrolladores que trabajan con IA. Backlog técnico, resúmenes diarios e integración MCP con ChatGPT.",
  "author": "Tobias Longstaff",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "worklog:start": "bun scripts/worklog-start.ts",
    "worklog:end": "bun scripts/worklog-end.ts",
    "worklog:status": "bun scripts/worklog-status.ts",
    "commit:plan": "bun scripts/commit-plan.ts",
    "backlog": "bun scripts/backlog-server.ts",
    "backlog:seed": "bun scripts/backlog-seed.ts",
    "dev": "bun scripts/dev-all.ts --web",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "bun scripts/dev-all.ts",
    "desktop:build": "bun run build:frontend && bun run build:server:win && tauri build",
    "build:server:win": "bun build --compile --target=bun-windows-x64 scripts/backlog-server.ts --outfile src-tauri/binaries/worklog-server-x86_64-pc-windows-msvc.exe",
    "build:server:mac-arm": "bun build --compile --target=bun-darwin-arm64  scripts/backlog-server.ts --outfile src-tauri/binaries/worklog-server-aarch64-apple-darwin",
    "build:server:mac-x64": "bun build --compile --target=bun-darwin-x64    scripts/backlog-server.ts --outfile src-tauri/binaries/worklog-server-x86_64-apple-darwin",
    "build:server:linux": "bun build --compile --target=bun-linux-x64     scripts/backlog-server.ts --outfile src-tauri/binaries/worklog-server-x86_64-unknown-linux-gnu"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
